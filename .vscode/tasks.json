{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenFOAM: Prepare cavity example",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\.vscode\\run-openfoam-example.ps1",
        "-Case",
        "tutorials/legacy/incompressible/icoFoam/cavity",
        "-Output",
        "runs/cavity",
        "-NoRun"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OpenFOAM: Run cavity example",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\.vscode\\run-openfoam-example.ps1",
        "-Case",
        "tutorials/legacy/incompressible/icoFoam/cavity",
        "-Output",
        "runs/cavity"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
